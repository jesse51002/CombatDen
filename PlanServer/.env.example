# PlanServer environment knobs. Copy to `.env` to override the compose defaults.
# `.env` is gitignored. Every value here is OPTIONAL — the defaults already run
# a working local single-user instance.

# ─── CRITICAL — DO NOT SET NODE_ENV=production ──────────────────────────────
# The plan app's isLocalPlanRuntime() HARD-REFUSES local single-user mode when
# NODE_ENV is "production" (or "prod"), flipping into hosted multi-tenant auth
# mode that REQUIRES a login + BETTER_AUTH_SECRET. Leave NODE_ENV UNSET.
# (Do not uncomment the next line — it is here only to warn you.)
# NODE_ENV=production   # <-- NEVER. Breaks local mode. Forces login.

# Local single-user mode is ON by default (NODE_ENV unset + AUTH_MODE unset).
# You may set these explicitly to make the intent loud; both are optional:
# AUTH_MODE=local
# PLAN_LOCAL_MODE=1

# ─── Bind / port ────────────────────────────────────────────────────────────
# Loopback-only bind. Do NOT change HOST to 0.0.0.0 — with `network_mode: host`
# that would expose an UNAUTHENTICATED instance on every interface.
# HOST=127.0.0.1
# NITRO_HOST=127.0.0.1
# PORT=3939
# NITRO_PORT=3939

# ─── Database ───────────────────────────────────────────────────────────────
# Unset -> defaults to file:./data/app.db (SQLite), persisted via the ./data
# volume. Only set this if you want an external Postgres/libSQL, etc.
# DATABASE_URL=

# ─── Local MDX mirror ───────────────────────────────────────────────────────
# Unset -> defaults to <cwd>/plans (i.e. /app/plans), persisted via ./plans.
# PLAN_LOCAL_DIR=plans

# ─── Telemetry (already off) ────────────────────────────────────────────────
# Suppresses the scaffolder/CLI one-time ping. Analytics/Sentry/Amplitude are
# all off-by-default (they need keys you are not setting). Kept on for clarity.
# DO_NOT_TRACK=1
# AGENT_NATIVE_TELEMETRY_DISABLED=1

# ─── Do NOT set these (they would turn OFF the no-auth local model) ─────────
# Setting any of these switches the MCP endpoint / app onto an authenticated
# path and defeats the loopback dev-open design:
# BETTER_AUTH_SECRET=
# ACCESS_TOKEN=
# A2A_SECRET=
