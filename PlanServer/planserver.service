# PlanServer boot-autostart unit (belt-and-suspenders).
#
# `restart: always` in compose keeps the container up while Docker runs, but it
# only survives a REBOOT if the Docker daemon is enabled at boot. This unit is a
# fallback that explicitly brings the compose project up at boot and down at
# shutdown, so autostart works even if you prefer not to enable docker.service
# globally.
#
# Install (run yourself — needs root; adjust the path if the repo moved):
#   sudo cp /var/home/jm/Documents/CombatDen/codebase/PlanServer/planserver.service /etc/systemd/system/planserver.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now planserver.service
#
# Either this unit OR `sudo systemctl enable --now docker` is enough for boot
# autostart; you do not strictly need both.

[Unit]
Description=PlanServer (agent-native Plans app + local MCP)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/var/home/jm/Documents/CombatDen/codebase/PlanServer
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
