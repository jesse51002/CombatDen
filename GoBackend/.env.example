# Server Configuration
SERVER_PORT=8090
SERVER_HOST=0.0.0.0
# ENV can be: DEV, QA, PROD
# Leave ENV unset for local development (uses .env.dev)
# Set ENV for production/QA (uses .env or system environment variables)
ENV=DEV

# Supabase Configuration
# For DEV: Use local Supabase (http://127.0.0.1:54321)
# For PROD: Use your production Supabase URL (https://your-project.supabase.co)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# Database Configuration
# For DEV: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# For PROD: postgresql://user:password@your-host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
