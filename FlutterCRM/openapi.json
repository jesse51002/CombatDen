{
  "openapi": "3.1.0",
  "info": {
    "title": "CombatDen API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/members/member_details": {
      "get": {
        "tags": [
          "members"
        ],
        "summary": "Get member details",
        "description": "Returns full details for a single member including all memberships, discounts, payment history, and rewards.",
        "operationId": "get_member_details_api_v1_members_member_details_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "crm_user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Crm User Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Member details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberDetailResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not authorized to view this member"
          },
          "404": {
            "description": "Member not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/members/crm_members_list": {
      "post": {
        "tags": [
          "members"
        ],
        "summary": "Get CRM members list",
        "description": "Returns a filtered, sorted, paginated list of gym members for the CRM members list screen.",
        "operationId": "crm_members_list_api_v1_members_crm_members_list_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrmMembersListRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Members list retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CrmMembersListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not authorized to access this gym"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/members/crm_total_counts": {
      "get": {
        "tags": [
          "members"
        ],
        "summary": "Get CRM member total counts",
        "description": "Returns unfiltered member counts per status for the CRM members list subtitle.",
        "operationId": "crm_total_counts_api_v1_members_crm_total_counts_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "gym_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Gym Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Total counts retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembersListTotalCounts"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Not authorized to access this gym"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Health check endpoint.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
