        "title": "CrmMembersListRequest",
        "description": "Request body for the CRM members list endpoint.\n\nAttributes:\n    gym_id: The gym to list members for.\n    prev_view: The view the user was on before this request.\n    requested_view: The view the user is requesting.\n    filters: Active filters from the frontend.\n    start_index: Pagination offset.\n    count: Number of rows to fetch per page."
      },
      "CrmMembersListResponse": {
        "properties": {
          "view": {
            "$ref": "#/components/schemas/MembersListView"
          },
          "filters": {
            "$ref": "#/components/schemas/MembersListFilters"
          },
          "data": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/AllViewRow"
                },
                {
                  "$ref": "#/components/schemas/TrialViewRow"
                },
                {
                  "$ref": "#/components/schemas/FrozenViewRow"
                },
                {
                  "$ref": "#/components/schemas/OverdueViewRow"
                }
              ],
              "discriminator": {
                "propertyName": "view",
                "mapping": {
                  "all": "#/components/schemas/AllViewRow",
                  "frozen": "#/components/schemas/FrozenViewRow",
                  "overdue": "#/components/schemas/OverdueViewRow",
                  "trial": "#/components/schemas/TrialViewRow"
                }
              }
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "view",
          "filters",
          "data"
        ],
        "title": "CrmMembersListResponse",
        "description": "Response for the CRM members list endpoint.\n\nAttributes:\n    view: The resolved view (echoed from request).\n    filters: The applied filters (echoed from request).\n    data: Pre-sorted, pre-filtered, pre-formatted rows."
      },
