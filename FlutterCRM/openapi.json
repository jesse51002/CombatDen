      "CrmMembersListRequest": {
        "properties": {
          "gym_id": {
            "type": "string",
            "format": "uuid",
            "title": "Gym Id"
          },
          "prev_view": {
            "$ref": "#/components/schemas/MembersListView"
          },
          "requested_view": {
            "$ref": "#/components/schemas/MembersListView"
          },
          "filters": {
            "$ref": "#/components/schemas/MembersListFilters",
            "default": {
              "membership_status": []
            }
          },
          "start_index": {
            "type": "integer",
            "title": "Start Index",
            "default": 0
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "default": 25
          }
        },
        "type": "object",
        "required": [
          "gym_id",
          "prev_view",
          "requested_view"
