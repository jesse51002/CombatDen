flowchart TB
  %% Scheduled reconciler — orchestration flow of ReconcilerService.run().
  %% Source of truth: src/reconciler/ (reconciler-guide skill).
  %% APScheduler (app lifespan) fires run() twice daily, then runs four
  %% step-services in order D -> B -> A -> C. No reconciler-wide lock — safety is
  %% the per-family PayingMemberLock every payment op already holds.
  %% Every step reuses existing machinery: D drives the webhook handler absorb()
  %% seam, B reads live subs + the shared CRM-only absorber, A uses the per-family
  %% lock, C calls bulk_payment_sync.
  %% (The customer.subscription.deleted webhook is a SEPARATE prompt-path
  %% feature that shares the absorber; it is not part of this sweep.)
  %% Green = reconciler step/service · yellow = the orchestrator (fan-out hub) ·
  %% orange = external actors. Solid = live runtime call.

  sched["⏰ APScheduler — app lifespan, cron twice daily (UTC)<br/>fires ReconcilerService.run() · gated by settings.reconciler_enabled"]

  subgraph recon["🧹 ReconcilerService.run — sweep orchestrator"]
    direction TB
    d["D · InvoiceFetchSweep — missed-webhook backstop<br/>per gym Connect acct: list ~2d invoices / payments / refunds<br/>→ reuse webhook handler absorb(obj) (the handle/absorb seam)<br/>paid → bill + succeeded charges · open+attempted → failed attempt · refunds<br/>idempotent: invoice upsert · charge/refund UNIQUE · failed synthetic key<br/>each object in its own txn · pending/not-recorded caught per object"]
    b["B · SubscriptionStatusSweep — Stripe→CRM absorption<br/>each active billing family: read live sub status<br/>canceled / not-found → absorb · past_due / unpaid → record-only · active → no-op"]
    a["A · OrphanCleanupSweep — delete stranded not_added rows<br/>per orphan: non-blocking try paying-family lock<br/>free → delete (stripe_item_id IS NULL guard) · held → skip (op in flight)"]
    c["C · PaymentPushSweep — CRM→Stripe converge<br/>distinct paying parents w/ active recurring → bulk_payment_sync<br/>proration none = billing none (no charge)"]
    d --> b
    b --> a
    a --> c
  end

  absorber["♻️ SubscriptionCancellationAbsorber — CRM-only (NO Stripe call)<br/>family's live recurring → cancel_date + stripe_sync_status='deleted'<br/>+ null parent stripe_sub_id_month · idempotent<br/>NOT the blessed cancel() (its pre-sync would push to the already-gone sub)"]
  handlers["📨 webhook handlers (stripe_webhooks) — absorb(obj) seam<br/>invoice_paid · invoice_payment_paid · invoice_payment_failed · refund"]
  engine["⚙️ PaymentSyncService.bulk_payment_sync<br/>loop families · fresh key + per-family lock · update_payments_recurring"]
  subret["🔎 PaymentsSubscriptionRetrieve.get_subscription<br/>live sub status (raises not-found / canceled)"]

  supabase["🗄️ Supabase (service-role) — resource_locks lease<br/>reconciler_orphan_memberships · reconciler_active_billing_members · gyms_with_connect<br/>cancel_date / 'deleted' writes · null stripe_sub_id_month · delete orphan"]
  stripe["💳 Stripe — gym Connect: list invoices / payments / refunds · retrieve subscription"]

  sched -->|"twice daily"| recon
  recon -->|"D: reuse handler absorb on listed objects"| handlers
  recon -->|"B: read live sub status"| subret
  recon -->|"B: absorb canceled / not-found"| absorber
  recon -->|"C: bulk push (billing none)"| engine
  recon -->|"A: list + delete orphans (per-family lock check)"| supabase
  recon -->|"D: list recent activity per gym"| stripe
  absorber -->|"CRM-only cancel + null sub id"| supabase
  handlers -->|"upsert invoice / charge / refund rows"| supabase
  subret -->|"retrieve subscription"| stripe
  engine -->|"read desired state · write back"| supabase
  engine -->|"create / update / cancel subscription"| stripe

  classDef svc fill:#e6f7ec,stroke:#2f8f53,color:#0c3a1f;
  classDef ext fill:#ffd9a8,stroke:#d2691e,color:#4a2c08;
  classDef hub fill:#fdf0c8,stroke:#caab2f,color:#4a3d08;
  class sched,absorber,handlers,engine,subret svc;
  class supabase,stripe ext;
  class d,b,a,c svc;
  style recon fill:#fdf0c8,stroke:#caab2f;
