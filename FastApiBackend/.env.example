# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect_xxx

# Stripe Connect Express onboarding
STRIPE_CONNECT_REFRESH_URL=https://your-domain.com/stripe/refresh
STRIPE_CONNECT_RETURN_URL=https://your-domain.com/stripe/return
STRIPE_CONNECT_EXPRESS_COUNTRY=US

# Database (direct Postgres connection)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/combatden

# YouTube Data API (owner-added video metadata lookups) — required
YOUTUBE_API_KEY=your-youtube-data-api-key

# LLM providers for the videos domain (spec agent, query gen, feed refiner, and
# the RAG recs/search readers). The provider prefix on each model setting selects
# which key is used. The matching video endpoint 500s until its key is set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional video/RAG tuning — safe defaults live in src/core/config.py; set only to override.
# VIDEO_LLM_MODEL=anthropic/claude-sonnet-4-6      # litellm provider/name — query gen + feed refiner
# VIDEO_AGENT_MODEL=claude-sonnet-4-6              # bare Anthropic model — the Pydantic AI agent
# VIDEO_AGENT_RETRIES=3
# VIDEO_QUERY_COUNT=30                             # queries generated per spec commit
# VIDEO_EMBEDDING_MODEL=openai/text-embedding-3-small
# VIDEO_EMBEDDING_DIM=1536                         # pinned to the vector(1536) DDL (cross-service contract)
# VIDEO_PROFILE_TTL_DAYS=30
# VIDEO_REC_WEIGHT_SIMILARITY=0.7
# VIDEO_REC_WEIGHT_RELEVANCE=0.2
# VIDEO_REC_WEIGHT_VIEWS=0.1
# VIDEO_SEARCH_LIMIT=20                            # route caps at 50

# App
APP_ENV=dev
APP_DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# ── Outbound email (the emails domain) ──────────────────────────────────
# CombatDen's OWN mail only. Supabase Auth's confirmation / password-reset
# mail is configured in the Supabase Dashboard (SMTP sender), and Stripe's
# card-declined mail is sent from each gym's own connected account — neither
# reads anything here.
RESEND_API_KEY=

# WHICH kinds may actually be DELIVERED. A kind that is absent is still
# claimed and logged (status 'held') but never sent, and the retry sweep
# skips held rows forever — so enabling a kind later cannot suddenly mail a
# backlog of people who joined months ago.
#
# EMPTY BY DEFAULT ON PURPOSE. Inbucket only catches GoTrue's mail; our
# client talks to Resend over HTTPS regardless of the local stack, so a dev
# box with this populated WILL email real members. Leave it empty locally
# unless you also set EMAIL_SANDBOX_REDIRECT.
# Production at launch: ["staff_onboarding"]  (member_app_invite stays off
# until the member app is actually installable).
EMAIL_ENABLED_KINDS=[]

# Forces EVERY recipient to this address. The safe way to test locally.
# EMAIL_SANDBOX_REDIRECT=you@example.com

# Optional — safe defaults live in src/core/config.py; set only to override.
# EMAIL_FROM_ADDRESS=hello@mail.combatden.net   # product mail: its own subdomain,
#                                               # so a spam complaint here cannot
#                                               # hurt login-mail deliverability
# EMAIL_FROM_NAME=CombatDen
# EMAIL_REPLY_TO=hello@combatden.net
# EMAIL_MAX_ATTEMPTS=5
# EMAIL_RETRY_BATCH_LIMIT=200
# EMAIL_RESEND_MAX_PER_HOUR=3                    # per person, per kind
# EMAIL_UNSUBSCRIBE_SECRET=                      # HMAC key for unsubscribe links;
#                                                # REQUIRED before any marketing kind goes live
# EMAIL_UNSUBSCRIBE_BASE_URL=https://api.combatden.net
