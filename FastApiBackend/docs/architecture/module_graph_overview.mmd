    end

    main --> members
    main --> classes
    main --> member_memberships
    main --> membership_plans
    main --> discounts
    main --> gyms
    main --> stripe_webhooks

    members --> classes
    members --> payments
    member_memberships --> payments
    discounts --> member_memberships
    discounts --> payments
    membership_plans --> member_memberships
    membership_plans --> payments
    gyms --> payments
    stripe_webhooks --> gyms
