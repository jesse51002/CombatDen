    members --> shared
    classes --> shared
    member_memberships --> shared
    membership_plans --> shared
    discounts --> shared
    gyms --> shared
    stripe_webhooks --> shared
    payments --> shared
    core --> shared

    classDef foundational fill:#e8f4fd,stroke:#1c6ea4,stroke-width:2px;
    classDef hub fill:#fff4e6,stroke:#d97706,stroke-width:2px;
