flowchart TB
  CRM["🖥️ CRM (caller) · WIP"]
  subgraph FastApiBackend["⚙️ FastApiBackend — CRM / billing API (WIP)"]
    direction TB
    r_mem["<b>members</b> · /api/v1/members · 16 routes<br/>POST /<br/>PUT /{member_id}<br/>POST /list<br/>GET /counts<br/>GET /{member_id}<br/>GET /{member_id}/billing<br/>PUT /{member_id}/card<br/>DELETE /{member_id}/payment<br/>PUT /{member_id}/link (authorize payer + sign waiver)<br/>POST /{member_id}/link/check<br/>POST /{member_id}/link/remove/preview<br/>POST /{member_id}/link/remove (cascade-cancel + de-authorize)<br/>GET /{member_id}/authorized-payer-waiver<br/>GET /{member_id}/invoices<br/>GET /{member_id}/upcoming-invoice<br/>GET /{member_id}/payments"]
    r_gym["<b>gyms</b> · /api/v1/gyms · 5 routes<br/>POST /<br/>GET /<br/>GET /{gym_id}/onboarding<br/>POST /{gym_id}/onboarding/link<br/>PUT /{gym_id}"]
    r_cls["<b>classes</b> · /api/v1/classes · 15 routes<br/>GET / · POST / · GET /{id} · PUT /{id} · DELETE /{id} (class CRUD)<br/>POST+GET /{id}/exceptions/instance<br/>POST+GET /{id}/exceptions/range<br/>GET /instances (schedule board)<br/>POST /checkin (gated · lazy materialize)<br/>POST /{id}/occurrences/{date}/checkin-batch (staff · 207)<br/>DELETE /{id}/occurrences/{date} (un-occur)<br/>POST /{id}/occurrences/{date}/reschedule<br/>GET /streak"]
    r_rank["<b>ranks</b> · /api/v1/ranks · 10 routes<br/>GET /<br/>POST /<br/>POST /from-preset<br/>GET /presets<br/>GET /presets/grouped<br/>GET /enabled<br/>PUT /enabled<br/>GET /{rank_id}<br/>PUT /{rank_id}<br/>DELETE /{rank_id}"]
    r_rew["<b>rewards</b> · /api/v1/rewards · 7 routes<br/>GET /<br/>GET /{reward_id}<br/>POST /<br/>PUT /{reward_id}<br/>DELETE /{reward_id}<br/>POST /{reward_id}/redeem<br/>GET /redemptions"]
    r_waiver["<b>waivers</b> · /api/v1/waivers · 8 routes<br/>GET /<br/>POST /<br/>PUT /<br/>DELETE /<br/>GET /{waiver_id}<br/>GET /{waiver_id}/versions<br/>GET /{waiver_id}/signatures<br/>GET /signatures/by-member/{member_id}"]
    r_disc["<b>discounts</b> · /api/v1/discounts · 4 routes<br/>(coupon-free presets)<br/>GET /<br/>POST /<br/>PUT /<br/>DELETE /"]
    r_mm["<b>memberships</b> · /api/v1/member_memberships · 16 routes<br/>DELETE / (cancel one+ recurring)<br/>POST /end (one-time/trial early-end)<br/>POST /freeze<br/>POST /unfreeze<br/>POST /<br/>PUT /price (same-plan reprice, direct)<br/>POST /reprice-plan (batch → task)<br/>POST /upgrade (cross-plan, charge diff)<br/>POST /upgrade/preview<br/>POST /preview<br/>POST /cancel/preview<br/>POST /discounts/add (preview bool)<br/>POST /discounts/remove (preview bool)<br/>POST /mark-paid-cash<br/>POST /charge-card<br/>POST /refund"]
    r_plan["<b>plans</b> · /api/v1/membership_plans · 7 routes<br/>POST /<br/>PUT /<br/>DELETE /<br/>GET /<br/>GET /{plan_id}<br/>GET /{plan_id}/prices<br/>POST /price"]
    r_hook["<b>stripe_webhooks</b> · /api/v1/stripe · 1 route<br/>POST /webhooks"]
    r_task["<b>tasks</b> · /api/v1/tasks · 2 routes<br/>(read-only polling for tracked background ops)<br/>GET /ongoing<br/>GET /{task_id}"]
    r_vid["<b>videos</b> · /api/v1/videos + /api/v1/gyms/{id}/videos · 8 routes<br/>GET /videos/templates<br/>GET /videos/templates/{id}<br/>GET /videos/templates/{id}/videos<br/>GET /videos/templates/{id}/videos/preview<br/>GET /gyms/{id}/videos<br/>GET /gyms/{id}/videos/preview<br/>GET /gyms/{id}/videos/spec<br/>GET /gyms/{id}/showcase"]
    r_pres["<b>presets</b> · /api/v1/gyms/{id}/presets · 1 route<br/>POST /gyms/{id}/presets/import (owner + email-allowlist gated)"]
    checkin_service["ClassesCheckinService<br/>src/classes/ · gated lazy check-in (trial→one_time→recurring, capacity, auto-end)"]
    cycle_counts_service["ClassesCycleCountsService"]
    classes_crud_service["ClassesCrudService<br/>src/classes/ · class CRUD + soft-delete (admin/owner-gated writes)"]
    classes_exceptions_service["ClassesExceptionsService<br/>src/classes/ · instance + range exception upsert/list<br/>(reschedule-conflict check via the expander)"]
    classes_schedule_reader_service["ClassesScheduleReaderService<br/>src/classes/ · the schedule board: expand classes + exceptions over a window"]
    classes_batch_checkin_service["ClassesBatchCheckinService<br/>src/classes/ · staff batch check-in (207); resolves the occurrence once, loops checkin"]
    classes_undo_service["ClassesUndoService<br/>src/classes/ · un-occur (cancel) + reschedule a single occurrence (one txn)"]
    classes_expander["ClassesExpander<br/>src/classes/ · PURE recurrence + exception engine (no I/O · shared singleton)"]
    classes_materializer["ClassesMaterializer<br/>src/classes/ · lazy idempotent find-or-create of a class_history occurrence"]
    crm_members_list_service["CrmMembersListService"]
    crm_total_counts_service["CrmTotalCountsService"]
    discounts_service["DiscountsService<br/>(plain gym config · db only)"]
    gym_stripe_service["GymStripeService"]
    gyms_service["GymsService"]
    gyms_stripe_connect_service["GymsStripeConnectService"]
    member_memberships_service["MemberMembershipsService<br/>src/memberships/ · DB-first lifecycle ops + verify/revert"]
    members_billing_detail_service["MembersBillingDetailService"]
    members_payments_service["MembersPaymentsService"]
    members_management_service["MembersManagementService"]
    member_memberships_refund_service["MemberMembershipsRefund<br/>src/memberships/ · card → Stripe refund + record; cash → record only"]
    payment_sync_service["PaymentSyncService — src/sync/ · declarative reconciler<br/>orchestrates: Builder→Discounts (coupons at build; freeze = 100%-off line),<br/>Stripe (execute), Writeback · -> None"]
    payment_sync_one_time["PaymentSyncOneTime — src/sync/ · one-shot one-time engine<br/>ONE consolidated invoice for pending one_time/trial memberships<br/>(start's non-recurring path) · reuses Discounts.resolve · NOT a converge"]
    payer_resolver["PayerResolver<br/>shared payer resolution (paid_by_member_id)"]
    membership_plans_service["MembershipPlansService<br/>src/plans/"]
    ranks_service["RanksService"]
    rewards_redemption_service["RewardsRedemptionService"]
    rewards_service["RewardsService"]
    streak_service["ClassesStreakService"]
    stripe_webhooks_service["StripeWebhooksService"]
    waivers_service["WaiversService"]
    memberships_linked["MemberMembershipsLinked<br/>src/memberships/ · authorize payer + check eligibility (many-to-many)<br/>writes member_authorized_payers + signs authorized-payer waiver<br/>in one txn (no orphan signatures); owns two-family lock"]
    videos_service["VideosService<br/>src/videos/ · public template catalog + authed gym content<br/>reads video_* + video_gym_* + gym_video_*"]
    presets_service["PresetsService<br/>src/presets/ · owner-gated template-→-gym import<br/>writes gym_video_spec/feed/query · gym_classes · gym_employees · gym_rewards · gyms.theme_design_id"]
    reconciler_service["ReconcilerService — twice-daily sweep (APScheduler)<br/>invoice-fetch → stale-task recovery → orphan-clean → push → sub-orphans (cancel unlinked subs)<br/>+ class-history materialize (6th step · NON-billing · independent)<br/>per-family lock guards mutations; no sweep-wide lock"]
    resource_lock["ResourceLock<br/>generic non-blocking TTL lease (resource_locks)"]
    tasks_service["TasksService — src/tasks/ · tracked background ops<br/>create/read tasks + items · the in-task guard<br/>(item-targeted membership ops reject mid-task rows → 409)"]
    tasks_executor["TasksExecutor — src/tasks/ · runs task items<br/>atomic claim → handler dispatch → retry ×3 → failed (ops self-revert)<br/>crash recovery via the reconciler's stale-task sweep"]
    memberships_reprice["MemberMembershipsReprice<br/>src/memberships/ · TASK-AGNOSTIC same-plan reprice (imports NOTHING from tasks):<br/>reprice (optional target → else plan active)<br/>extends MemberMembershipsTransitionBase: cancel old + insert successor + copy discounts (txn) → converge → verify-or-REVERT"]
    memberships_upgrade["MemberMembershipsUpgrade<br/>src/memberships/ · CROSS-PLAN upgrade (standalone, no batch):<br/>upgrade/upgrade_preview → successor on a DIFFERENT plan, charge the prorated difference (downgrade = no charge)<br/>shares MemberMembershipsTransitionBase with reprice"]
    membership_reprice_task_handler["MembershipRepriceTaskHandler<br/>src/tasks/ · the ONE tasks↔memberships bridge (tasks → memberships):<br/>create_batch (discover targets + enqueue one item/membership) · execute_item (run + record successor)"]
    memberships_invoice_fetch["MemberMembershipsInvoiceFetch<br/>src/memberships/ · on-demand post-op fetch engine:<br/>fetch_for_payer (per-payer, retry/early-stop on created >= op_start)<br/>+ reconciler backstop sweep_account (per account)<br/>· applies via webhook record() seams · payer with no billing profile = no-op"]
    memberships_invoice_fetch_runner["MembershipsInvoiceFetchRunner<br/>src/memberships/ · fire-and-forget asyncio.create_task runner (Singleton)<br/>start_for_payer fired AFTER each invoice-creating op<br/>(after payer lock releases); drain() on shutdown"]
    subgraph Payments["💳 Payments — Stripe core (router-less)"]
      direction TB
      p_client["PaymentsStripeClient"]
      p_price["PaymentsStripePriceService"]
      p_disc["PaymentsStripeDiscountService"]
      p_members["PaymentsStripeMembersService"]
      p_membership["PaymentsStripeMembershipService"]
      p_payment["PaymentsStripePaymentService"]
      p_sub["PaymentsStripeSubscriptionService<br/>+ retrieve (read current discounts)"]
      p_price --> p_client
      p_disc --> p_client
      p_members --> p_client
      p_membership --> p_client
      p_membership --> p_price
      p_payment --> p_client
      p_payment --> p_members
      p_payment --> p_price
      p_sub --> p_client
      p_sub --> p_members
      p_sub --> p_price
      p_sub --> p_disc
    end
    r_mem --> crm_members_list_service
    r_mem --> crm_total_counts_service
    r_mem --> members_billing_detail_service
    r_mem --> members_payments_service
    r_mem --> members_management_service
    r_mm --> member_memberships_refund_service
    r_gym --> gyms_service
    r_cls --> checkin_service
    r_cls --> streak_service
    r_cls --> classes_crud_service
    r_cls --> classes_exceptions_service
    r_cls --> classes_schedule_reader_service
    r_cls --> classes_batch_checkin_service
    r_cls --> classes_undo_service
    checkin_service --> cycle_counts_service
    checkin_service --> classes_expander
    checkin_service --> classes_materializer
    classes_batch_checkin_service --> checkin_service
    classes_exceptions_service --> classes_expander
    classes_schedule_reader_service --> classes_expander
    classes_undo_service --> classes_expander
    r_rank --> ranks_service
    r_rew --> rewards_redemption_service
    r_rew --> rewards_service
    r_waiver --> waivers_service
    r_disc --> discounts_service
    r_mm --> member_memberships_service
    r_plan --> membership_plans_service
    r_hook --> stripe_webhooks_service
    r_task --> tasks_service
    r_vid --> videos_service
    r_pres --> presets_service
    r_mm -->|"batch reprice: discover + create"| membership_reprice_task_handler
    r_mm -->|"in-task guard (item ops)"| tasks_service
    r_mm -->|"fire batch run"| tasks_executor
    member_memberships_service -->|"single reprice (direct)"| memberships_reprice
    member_memberships_service -->|"cross-plan upgrade (direct)"| memberships_upgrade
    membership_reprice_task_handler -->|"enqueue"| tasks_service
    tasks_executor -->|"membership_reprice handler"| membership_reprice_task_handler
    membership_reprice_task_handler --> memberships_reprice
    memberships_reprice --> payment_sync_service
    memberships_reprice --> gym_stripe_service
    memberships_upgrade --> payment_sync_service
    memberships_upgrade --> gym_stripe_service
    member_memberships_service --> memberships_invoice_fetch_runner
    memberships_invoice_fetch_runner --> memberships_invoice_fetch
    memberships_invoice_fetch -->|"webhook record() seams"| stripe_webhooks_service
    memberships_invoice_fetch --> payer_resolver
    memberships_invoice_fetch -->|"list invoices/refunds/payments"| Payments
    stripe_webhooks_service -->|"invoice.paid → settle once discounts"| payment_sync_service
    stripe_webhooks_service -->|"invoice_payment.paid → retrieve PaymentIntent for charge id"| Payments
    members_billing_detail_service --> streak_service
    members_billing_detail_service --> cycle_counts_service
    members_management_service --> Payments
    member_memberships_refund_service -->|"card refund"| Payments
    member_memberships_refund_service --> gym_stripe_service
    gyms_service --> gyms_stripe_connect_service
    gyms_stripe_connect_service --> Payments
    member_memberships_service --> payment_sync_service
    member_memberships_service -->|"start: one-time / trial group"| payment_sync_one_time
    member_memberships_service --> Payments
    member_memberships_service --> gym_stripe_service
    member_memberships_service --> payer_resolver
    member_memberships_service -->|"mint inline custom discounts at start"| discounts_service
    member_memberships_service -->|"start: save one-off card as default"| members_management_service
    member_memberships_service -->|"authorize payer + check eligibility (link)"| memberships_linked
    memberships_linked -->|"sign authorized-payer waiver at authorize"| waivers_service
    payment_sync_one_time --> Payments
    payment_sync_one_time --> payer_resolver
    membership_plans_service --> gym_stripe_service
    membership_plans_service --> Payments
    membership_plans_service --> payment_sync_service
    payment_sync_service --> Payments
    payment_sync_service --> payer_resolver
    payer_resolver --> gym_stripe_service
    reconciler_service --> resource_lock
    reconciler_service -->|"invoice-fetch: delegates per gym"| memberships_invoice_fetch
    reconciler_service -->|"stale-task recovery: re-run unfinished"| tasks_executor
    reconciler_service -->|"push: bulk_payment_sync (billing none)"| payment_sync_service
    reconciler_service -->|"sub-orphans: list + cancel unlinked subs"| Payments
    reconciler_service --> payer_resolver
    reconciler_service -->|"class-history sweep (non-billing): expand past occurrences"| classes_expander
    reconciler_service -->|"class-history sweep: find-or-create class_history"| classes_materializer
    stripe_webhooks_service -->|"customer.subscription.deleted → sync"| payment_sync_service
  end
  Supabase["🗄️ Supabase<br/>Postgres + Auth (our DB)<br/>member_membership_applied_discounts<br/>(applied-discount rows · sync writes back stripe_coupon_id + status)"]
  Stripe["Stripe — payments · Connect · webhooks"]
  CRM -->|"authenticated REST · Supabase JWT · WIP"| FastApiBackend
  FastApiBackend -->|"read/write · JWT auth · read+write applied-discount rows"| Supabase
  FastApiBackend -->|"via Payments core · compute coupons at sync, write back stripe_coupon_id"| Stripe
  Stripe -.->|"webhooks → /api/v1/stripe/webhooks"| FastApiBackend
  classDef client fill:#eaf2ff,stroke:#2f6fb0,color:#0b2942;
  classDef ext fill:#ffd9a8,stroke:#d2691e,color:#4a2c08;
  classDef route fill:#eef2ff,stroke:#5b6bb0,color:#222;
  classDef svc fill:#e6f7ec,stroke:#2f8f53,color:#0c3a1f;
  classDef hub fill:#fdf0c8,stroke:#caab2f,color:#4a3d08;
  class CRM client;
  class Supabase,Stripe ext;
  class r_mem,r_gym,r_cls,r_rank,r_rew,r_waiver,r_disc,r_mm,r_plan,r_hook,r_task,r_vid,r_pres route;
  class checkin_service,cycle_counts_service,classes_crud_service,classes_exceptions_service,classes_schedule_reader_service,classes_batch_checkin_service,classes_undo_service,classes_expander,classes_materializer,crm_members_list_service,crm_total_counts_service,discounts_service,gym_stripe_service,gyms_service,gyms_stripe_connect_service,member_memberships_service,members_billing_detail_service,members_payments_service,members_management_service,member_memberships_refund_service,membership_plans_service,payment_sync_one_time,ranks_service,rewards_redemption_service,rewards_service,streak_service,stripe_webhooks_service,waivers_service,memberships_linked,resource_lock,tasks_service,tasks_executor,memberships_reprice,memberships_upgrade,membership_reprice_task_handler,memberships_invoice_fetch,memberships_invoice_fetch_runner,videos_service,presets_service svc;
  class payment_sync_service,payer_resolver,reconciler_service hub;
  style CRM stroke-dasharray:4 3;
  style FastApiBackend fill:#f4f9f6,stroke:#2f8f53,stroke-dasharray:5 4;
