flowchart TB
  CRM["🖥️ CRM (staff caller) · WIP"]
  MobileApp["📱 MobileApp (member caller) · not wired yet"]
  subgraph FastApiBackend["⚙️ FastApiBackend — CRM / billing API (WIP)"]
    direction TB
    r_mem["<b>members</b> · /api/v1/members · 17 routes<br/>POST /<br/>PUT /{member_id}<br/>POST /list<br/>GET /counts<br/>GET /{member_id}<br/>GET /{member_id}/billing<br/>PUT /{member_id}/card<br/>DELETE /{member_id}/payment<br/>PUT /{member_id}/link (authorize payer + sign waiver)<br/>POST /{member_id}/link/check<br/>POST /{member_id}/link/remove/preview<br/>POST /{member_id}/link/remove (cascade-cancel + de-authorize)<br/>GET /{member_id}/authorized-payer-waiver<br/>GET /{member_id}/invoices<br/>GET /{member_id}/upcoming-invoice<br/>GET /{member_id}/payments<br/>POST /{member_id}/points (award/adjust points)"]
    r_gym["<b>gyms</b> · /api/v1/gyms · 7 routes<br/>POST /<br/>GET /<br/>GET /{gym_id}/onboarding<br/>POST /{gym_id}/onboarding/link<br/>PUT /{gym_id}<br/>PUT /{gym_id}/theme (ThemeService design id)<br/>PUT /{gym_id}/employees/me/theme"]
    r_emp["<b>employees</b> · /api/v1/employees · 4 routes<br/>GET /{gym_id} (list=STAFF, incl. derived invite_status; instructor picker)<br/>POST /{gym_id} (create, OWNER_ADMIN)<br/>PUT /{gym_id}/{employee_id} (update, owner-row+email protected, OWNER_ADMIN)<br/>DELETE /{gym_id}/{employee_id} (soft-archive, OWNER_ADMIN)"]
    r_cls["<b>classes</b> · /api/v1/classes · 14 routes<br/>GET / · POST / · GET /{id} · PUT /{id} · DELETE /{id} (class CRUD)<br/>POST+GET /{id}/exceptions/instance<br/>POST+GET /{id}/exceptions/range<br/>PUT+DELETE /{id}/exceptions/range/{exception_id} (edit/remove a cancelled range)<br/>GET /instances (schedule board — attendance_count + signup_count per occurrence)<br/>DELETE /{id}/occurrences/{date} (un-occur)<br/>POST /{id}/occurrences/{date}/reschedule"]
    r_chk["<b>checkin</b> · /api/v1 · 8 routes<br/>POST /checkin (is_member gate · staff clean-records / warns→confirm; ignore_warnings overrides · kiosk strict)<br/>DELETE /checkin (reverse one member's check-in)<br/>POST /checkin/batch (207 · class_id+occurrence_date in body)<br/>GET /checkin/attendees (combined roster: signed-up OR attended, each flagged)<br/>POST /signup (reserve a spot; capacity-gated on the signed-up-or-attended union)<br/>DELETE /signup (cancel a member's sign-up)<br/>GET /checkin/history (member class-history feed: reservations + attended + no-shows)<br/>GET /streak"]
    r_rank["<b>ranks</b> · /api/v1/ranks · 15 routes<br/>GET /<br/>POST /<br/>POST /from-preset<br/>GET /presets<br/>GET /presets/grouped<br/>GET /enabled<br/>PUT /enabled<br/>POST /promote-member<br/>POST /set-member-rank<br/>POST /reorder<br/>GET /ready-to-promote<br/>GET /{rank_id}/members<br/>GET /{rank_id}<br/>PUT /{rank_id}<br/>DELETE /{rank_id}"]
    r_rep["<b>reports</b> · /api/v1/gyms/{gym_id}/reports · 2 routes<br/>GET /{gym_id}/reports/report?month=YYYY-MM (period op. report zip; month omitted = all-time)<br/>GET /{gym_id}/reports/full-export (full raw-data export zip)<br/>owner/admin only · reads Supabase only, no Stripe, no writes"]
    r_rew["<b>rewards</b> · /api/v1/rewards · 11 routes<br/>GET /<br/>GET /{reward_id}<br/>POST /<br/>PUT /{reward_id}<br/>DELETE /{reward_id}<br/>POST /{reward_id}/redeem (member-initiated → pending)<br/>POST /{reward_id}/redeem-for-member (staff-initiated → approved; override drains to zero)<br/>GET /redemptions/pending (gym-wide queue, paginated)<br/>POST /redemptions/{redemption_id}/approve<br/>POST /redemptions/{redemption_id}/reject (refunds the debit)<br/>GET /redemptions"]
    r_waiver["<b>waivers</b> · /api/v1/waivers · 9 routes<br/>GET /<br/>POST /<br/>PUT /<br/>DELETE /<br/>GET /{waiver_id}<br/>GET /{waiver_id}/versions<br/>GET /{waiver_id}/signatures<br/>POST /{waiver_id}/signatures (record signature, version-locked)<br/>GET /signatures/by-member/{member_id}"]
    r_disc["<b>discounts</b> · /api/v1/discounts · 4 routes<br/>(coupon-free presets)<br/>GET /<br/>POST /<br/>PUT /<br/>DELETE /"]
    r_mm["<b>memberships</b> · /api/v1/member_memberships · 17 routes<br/>DELETE / (cancel one+ recurring)<br/>POST /cancel-one-time (one-time/trial manual cancel — writes cancel_date)<br/>POST /freeze<br/>POST /unfreeze<br/>POST /<br/>PUT /price (same-plan reprice, direct)<br/>POST /reprice-plan (batch → task)<br/>POST /upgrade (cross-plan, charge diff)<br/>POST /upgrade/preview<br/>POST /preview<br/>POST /cancel/preview<br/>POST /discounts/add (preview bool)<br/>POST /discounts/remove (preview bool)<br/>POST /mark-paid-cash<br/>POST /retry-card (retry the open invoice on the saved default card)<br/>POST /charge-card<br/>POST /refund"]
    r_plan["<b>plans</b> · /api/v1/membership_plans · 7 routes<br/>POST /<br/>PUT /<br/>DELETE /<br/>GET /<br/>GET /{plan_id}<br/>GET /{plan_id}/prices<br/>POST /price"]
    r_hook["<b>stripe_webhooks</b> · /api/v1/stripe · 1 route<br/>POST /webhooks"]
    r_task["<b>tasks</b> · /api/v1/tasks · 2 routes<br/>(read-only polling for tracked background ops)<br/>GET /ongoing<br/>GET /{task_id}"]
    r_vid["<b>videos</b> · /api/v1/gyms/{id}/videos + /video-spec + /video-agent + /members/{mid}/video-rec · 13 routes<br/>GET /gyms/{id}/videos (unified feed: owner+latest-run merge, enriched-only; ?member_id personalizes)<br/>GET /gyms/{id}/videos/owner (ungated owner mgmt listing — pre-enrichment)<br/>POST /gyms/{id}/videos/lookup<br/>POST /gyms/{id}/videos<br/>DELETE /gyms/{id}/videos/{video_id}<br/>POST /gyms/{id}/videos/{video_id}/keep<br/>GET /gyms/{id}/videos/preview<br/>GET /gyms/{id}/videos/spec<br/>GET /gyms/{id}/video-spec<br/>POST /gyms/{id}/video-agent (accept via accepted_spec)<br/>POST /gyms/{id}/video-agent/refine-from-feed<br/>GET /gyms/{id}/members/{member_id}/video-rec (verify_gym_employee_for_member OWNER_ADMIN)<br/>POST /gyms/{id}/members/{member_id}/video-rec/{rec_id}/click (verify_gym_employee_for_member OWNER_ADMIN)"]
    r_pres["<b>presets</b> · /api/v1/gyms/{id}/presets + /api/v1/presets/templates · 5 routes<br/>POST /gyms/{id}/presets/import (owner + email-allowlist gated)<br/>GET /presets/templates<br/>GET /presets/templates/{video_gym_id}<br/>GET /presets/templates/{video_gym_id}/videos<br/>GET /presets/templates/{video_gym_id}/videos/preview"]
    r_theme["<b>theme</b> · /api/v1/gyms/{id}/showcase + /api/v1/theme · 2 routes<br/>GET /gyms/{id}/showcase (gym-employee gated)<br/>GET /theme/showcase-defaults (PUBLIC — category-keyed demo cards)"]
    r_upl["<b>uploads</b> · /api/v1/uploads · 1 route<br/>POST /image (multipart + category form field → CDN URL; staff-principal gated)"]
    r_growth["<b>growth</b> · /api/v1/growth · 1 route<br/>GET / (cached per-gym analytics; registry-owned name/categories/order attached at serve time)"]
    r_mp["<b>member_portal</b> · /api/v1/member · 13 routes · verify_member_self (member-facing)<br/>GET /members (verify_verified_account — the caller's member rows across gyms)<br/>GET /gyms/{gid}/members/{mid} (own profile: rank · points · streak · memberships · redemptions)<br/>GET .../streak · GET .../class-history<br/>GET .../classes (the gym schedule board, read-only)<br/>POST .../signup · DELETE .../signup (own reservation)<br/>GET .../rewards (active only) · GET .../redemptions<br/>POST .../rewards/{rid}/redeem (always PENDING — never auto-approve)<br/>GET .../videos (served feed only) · GET .../video-rec · POST .../video-rec/{rec}/click"]
    checkin_class_resolver["CheckinClassResolver<br/>src/checkin/ · resolve one occurrence against the class's schedule versions + exceptions (pure read)<br/>(the one-way checkin → classes dependency)"]
    checkin_member_gate["CheckinMemberGate<br/>src/checkin/ · per-member gate + write<br/>(eligibility, capacity vs the signed-up-or-attended union,<br/>unsigned-waiver gate, plan select trial→one_time→recurring, auto-end)"]
    cycle_counts_service["CycleCountsService<br/>src/checkin/"]
    batch_checkin_service["BatchCheckinService<br/>src/checkin/ · staff batch check-in (207); resolves the occurrence once, loops checkin"]
    checkin_attendees_service["CheckinAttendeesService<br/>src/checkin/ · read-only: the combined signed-up-or-attended roster of one occurrence"]
    checkin_remover["CheckinRemover<br/>src/checkin/ · reverse one member's check-in: find the occurrence, delegate to CheckinReverser"]
    checkin_reverser["CheckinReverser<br/>src/checkin/ · shared per-member reversal core (attendance/points/activity/auto-end); imports nothing from src.classes"]
    signup_service["SignupService<br/>src/checkin/ · create/remove a member's reservation (sign-up);<br/>capacity check reads the same signed-up-or-attended union CheckinMemberGate reads"]
    classes_crud_service["ClassesCrudService<br/>src/classes/ · class CRUD: identity in place, schedule via the mint engine;<br/>soft-delete runs the future-keyed wipe (admin/owner-gated writes)"]
    classes_exceptions_service["ClassesExceptionsService<br/>src/classes/ · instance + range exception upsert/list<br/>(reschedules delegate to the undo service's shared engine)"]
    classes_schedule_reader_service["ClassesScheduleReaderService<br/>src/classes/ · the schedule board: pure version expansion over a window (past + future alike);<br/>plain cross-domain reads of checkin's tables for signup_count + attendance_count"]
    classes_undo_service["ClassesUndoService<br/>src/classes/ · un-occur (cancel) + reschedule a single occurrence (one txn)"]
    classes_expander["ClassesExpander<br/>src/classes/ · PURE single-shape recurrence + exception engine (no I/O · shared singleton)"]
    classes_version_expander["ClassesVersionExpander<br/>src/classes/ · PURE versioned expander: ownership windows by effective_from,<br/>per-version frozen timezone, no-day-doubling dedup (wraps ClassesExpander)"]
    classes_versions_service["ClassesVersionsService<br/>src/classes/ · THE mint engine — only writer of gym_class_schedules:<br/>mint a version effective now + the version-change wipe (exact-slot survivors kept);<br/>soft-delete wipe · gym tz-change re-mint"]
