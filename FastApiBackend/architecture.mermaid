    payment_sync_one_time["PaymentSyncOneTime — src/sync/ · one-shot one-time engine<br/>ONE consolidated invoice for pending one_time/trial memberships<br/>(start's non-recurring path) · reuses Discounts.resolve · NOT a converge"]
    payer_resolver["PayerResolver<br/>shared payer resolution (paid_by_member_id)"]
    membership_plans_service["MembershipPlansService<br/>src/plans/"]
    ranks_service["RanksService<br/>src/ranks/ · facade over the rank concerns (keeps single-rank CRUD + the is_rank_enabled toggle)"]
    ranks_members["RanksMembers<br/>src/ranks/ · leaf-aware member-rank changes (promote/set, audit-logged) + the lowest-rank backfill helpers"]
    ranks_reorder["RanksReorder<br/>src/ranks/ · full-ladder two-phase reorder (main-only)"]
    ranks_presets["RanksPresets<br/>src/ranks/ · seed-from-preset (+ sets gym sub_rank_type) + preset catalog reads (composes RanksMembers for the shared backfill)"]
    ranks_reads["RanksReads<br/>src/ranks/ · paginated ready-to-promote + members-in-rank reads (derives sub-labels from the gym's sub_rank_type)"]
    reports_period_service["ReportsPeriodService<br/>src/reports/service/ · period (month/all-time) operational report zip:<br/>payments · invoices · line items · discounts · membership changes · new members · attendance · class stats + summary.csv<br/>decimal-dollar money · gym-local datetimes · reads the FILTERED membership/plan views"]
    reports_full_export_service["ReportsFullExportService<br/>src/reports/service/ · full raw-data export: every gym-owned table dumped to CSV<br/>(members · memberships · plans/prices · invoices/charges/line items/discounts · attendance/signups · classes/schedules · rewards/redemptions · waivers/versions/signatures · authorized_payers · activities · employees)<br/>no transformation — raw cents/UTC/UUIDs; each CSV header IS the SELECT column list"]
    rewards_redemption_service["RewardsRedemptionService"]
    rewards_service["RewardsService"]
    streak_service["StreakService<br/>src/checkin/"]
    checkin_history_service["CheckinHistoryService<br/>src/checkin/ · member class-history feed (open reservations + paginated attended/no-show history)"]
    stripe_webhooks_service["StripeWebhooksService"]
    waivers_service["WaiversService"]
    memberships_linked["MemberMembershipsLinked<br/>src/memberships/ · authorize payer + check eligibility (many-to-many)<br/>signs the payer-auth waiver via the shared sign_waiver (own txn),<br/>then writes member_authorized_payers (retry may leave a harmless<br/>extra append-only signature — by design); owns two-family lock"]
    videos_service["VideosService<br/>src/videos/ · PURE FACADE — composes VideoFeedService, VideoSpecService,<br/>VideoSpecAuthoring, VideoFeedRefiner, VideoRecsService, VideoRecClickService<br/>the router + the video-agent inject this, never the concern services directly"]
    video_feed_service["VideoFeedService<br/>src/videos/service/ · THE unified feed: load_feed_page<br/>(owner + latest-COMPLETED-run merge · enriched+accepted INNER JOIN video_rag gate ·<br/>σ-scaled owner boost + decayed watch-penalty, ranked vs member embedding or relevance)<br/>+ load_owner_videos (ungated /videos/owner mgmt listing, LEFT JOIN video_rag)<br/>+ lookup/add/remove/keep (YouTube Data API metadata; add owns video.gym_id + added_via=manual)"]
    presets_service["PresetsService<br/>src/presets/ · owner-gated template-→-gym import<br/>writes gym_video_spec (system_update version) + gym_video_feed · gym_classes · gym_employees · gym_rewards · gyms.theme_design_id · membership_plans (image_url re-point onto the imported class photos)"]
    presets_template_service["PresetsTemplateService<br/>src/presets/service/ · public template catalog reads<br/>list_template_cards · load_template · load_template_feed_ids<br/>reads template_gym_* tables (slug-keyed demo templates)"]
    theme_showcase_service["ThemeShowcaseService<br/>src/theme/service/ · gym showcase assembly<br/>load_showcase_classes · load_showcase_rewards<br/>reads gym_classes ⋈ gym_class_schedules_current (weekday_slots instructor) ⋈ gym_employees + gym_rewards"]
    theme_showcase_defaults_service["ThemeShowcaseDefaultsService<br/>src/theme/service/ · PUBLIC, no DB<br/>category-keyed demo class/reward cards from a bundled YAML file<br/>(ShowcaseCategory — 8-bucket vocabulary mirroring ParentGymType)"]
    uploads_s3_service["UploadsS3Service<br/>src/uploads/service/ · boto3 proxy into combatden-assets<br/>size-caps the multipart part before buffering, then the byte count as a backstop"]
    member_portal_service["MemberPortalService<br/>src/member_portal/service/ · the two reads no staff service answers:<br/>list_members_for_email (verified email → member rows across gyms — the portal entry point)<br/>get_profile (projects MembersBillingDetailService down to the member-facing profile)"]
    litellm_client["LiteLLMClient — src/shared/litellm_client.py<br/>complete_structured(prompt, schema, model) · model=provider/name<br/>resolves provider key from settings · Singleton"]
    video_spec_service["VideoSpecService — src/videos/service/<br/>spec DB read/write · load_latest · save_version · no LLM"]
    video_query_generator["VideoQueryGenerator — src/videos/service/<br/>litellm TWO-CALL query gen: landscape (LandscapeResult) → queries<br/>~⅓ name-targeted · count = video_query_count · called by VideoSpecAuthoring.commit"]
    video_spec_authoring["VideoSpecAuthoring — src/videos/service/<br/>deterministic commit gate: diff guard → query gen → save (no enqueue — worker self-derives)<br/>commit(gym_id, criteria, *, source) → VideoSpecView | None"]
    member_video_profile_service["MemberVideoProfileService — src/videos/service/<br/>ONE LLM summary + embedding on members.video_profile_*<br/>verify_member_in_gym (read-only guard) · refresh_if_due (3d cooldown) — builds ONLY on refresh"]
    video_recs_service["VideoRecsService — src/videos/service/<br/>get_rec: ONE rotating-category pick (served-count % rotation)<br/>THIN wrapper over video_feed_service.load_feed_page(limit=1) — same σ-boost + decay ranking, no separate rec SQL<br/>records member_video_recs (RETURNING rec_id)"]
    video_rec_click_service["VideoRecClickService — src/videos/service/<br/>record_click: stamp member_video_recs.clicked_at (idempotent) +<br/>log a video_clicked activity → fire the profile refresh"]
    member_video_profile_refresh_runner["MemberVideoProfileRefreshRunner — src/videos/service/<br/>fire-and-forget refresh_if_due runner (drain() in lifespan)<br/>triggers: video-click + class sign-up · max once / 3d"]
    video_feed_refiner["VideoFeedRefiner — src/videos/service/<br/>litellm feed→criteria refine · refine_from_feed<br/>delegates commit to VideoSpecAuthoring · prompt: video_feed_refine.md"]
    video_feed_refine_runner["VideoFeedRefineRunner — src/videos/service/<br/>fire-and-forget, per-gym-COALESCED feed_update auto-refine (drain() in lifespan)<br/>fired router-level on reject/keep ONLY (not owner add/remove)<br/>→ VideoFeedRefiner.refine_from_feed → a feed_update spec version (worker scan re-judges ~1h later)"]
    video_agent_service["VideoAgentService — src/videos/service/video_agent/<br/>THIN WRAPPER · agent_turn only · NO tools<br/>Pydantic AI (AnthropicModel · settings.video_agent_model)<br/>output: str | VideoSpecDraft | AgentQuestion (multi-choice chips)<br/>accept-path: accepted_spec → videos_service.save_accepted_spec<br/>system prompt: src/videos/prompts/video_agent_system.md"]
    reconciler_service["ReconcilerService — twice-daily sweep (APScheduler)<br/>invoice-fetch → stale-task recovery → orphan-clean → push → sub-orphans (cancel unlinked subs)<br/>per-family lock guards mutations; no sweep-wide lock"]
    growth_service["GrowthService — src/growth/ · READ path only<br/>get_growth: reads gym_growth_metrics, validates each payload against the registry model<br/>unknown key / stale payload = skipped (self-heals next compute); registry type always wins"]
    growth_compute_service["GrowthComputeService — src/growth/ · hourly + at-launch sweep (APScheduler, IntervalTrigger + next_run_time=now)<br/>per gym: run each registry metric .sql → validate → UPSERT gym_growth_metrics → prune retired keys<br/>every metric individually try/except-guarded; missing .sql logged + skipped"]
    resource_lock["ResourceLock<br/>generic non-blocking TTL lease (resource_locks)"]
    tasks_service["TasksService — src/tasks/ · tracked background ops<br/>create/read tasks + items · the in-task guard<br/>(item-targeted membership ops reject mid-task rows → 409)"]
    tasks_executor["TasksExecutor — src/tasks/ · runs task items<br/>atomic claim → handler dispatch → retry ×3 → failed (ops self-revert)<br/>crash recovery via the reconciler's stale-task sweep"]
    memberships_reprice["MemberMembershipsReprice<br/>src/memberships/ · TASK-AGNOSTIC same-plan reprice (imports NOTHING from tasks):<br/>reprice (optional target → else plan active)<br/>extends MemberMembershipsTransitionBase: cancel old + insert successor + copy discounts (txn) → converge → verify-or-REVERT"]
    memberships_upgrade["MemberMembershipsUpgrade<br/>src/memberships/ · CROSS-PLAN upgrade (standalone, no batch):<br/>upgrade/upgrade_preview → successor on a DIFFERENT plan, charge the prorated difference (downgrade = no charge)<br/>shares MemberMembershipsTransitionBase with reprice"]
    membership_reprice_task_handler["MembershipRepriceTaskHandler<br/>src/tasks/ · the ONE tasks↔memberships bridge (tasks → memberships):<br/>create_batch (discover targets + enqueue one item/membership) · execute_item (run + record successor)"]
    memberships_invoice_fetch["MemberMembershipsInvoiceFetch<br/>src/memberships/ · on-demand post-op fetch engine:<br/>fetch_for_payer (per-payer, retry/early-stop on created >= op_start)<br/>+ reconciler backstop sweep_account (per account)<br/>+ apply_invoice (synchronous single-invoice by KNOWN id — settle path)<br/>· applies via webhook record() seams · payer with no billing profile = no-op"]
    memberships_invoice_fetch_runner["MembershipsInvoiceFetchRunner<br/>src/memberships/ · fire-and-forget asyncio.create_task runner (Singleton)<br/>start_for_payer fired AFTER each invoice-creating op<br/>(after payer lock releases); drain() on shutdown"]
