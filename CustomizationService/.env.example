# Single env file. The app reads it (pydantic-settings) and `make proxy`
# sources it for the LiteLLM proxy. Copy to .env and fill the TODOs.

# LiteLLM proxy the app talks to.
LITELLM_PROXY_URL=http://localhost:4000
# Shared local secret between app and proxy (proxy uses it as its master key).
LITELLM_PROXY_KEY=sk-local-dev

# Provider keys (used by the proxy process).
ANTHROPIC_API_KEY=TODO-set-anthropic-api-key
GEMINI_API_KEY=TODO-set-gemini-api-key
BFL_API_KEY=TODO-set-bfl-api-key


# PhotoRoom (background removal, called direct by the app, not the proxy).
PHOTOROOM_API_KEY=TODO-set-photoroom-api-key

# App logging level.
LOG_LEVEL=DEBUG
