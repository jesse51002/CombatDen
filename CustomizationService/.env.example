# Single env file. The app reads it (pydantic-settings). Copy to .env
# and fill the TODOs.

# Provider keys — the app calls each provider directly via litellm,
# routed by the provider prefix on each call's model id (model ids are
# per-call constants in the module that makes the call, not env vars).
# ANTHROPIC_API_KEY: image-prompt text. GEMINI_API_KEY: complexity
# classification + vision cutout validator. OPENAI_API_KEY: image
# generation (gpt-image).
ANTHROPIC_API_KEY=TODO-set-anthropic-api-key
GEMINI_API_KEY=TODO-set-gemini-api-key
OPENAI_API_KEY=TODO-set-openai-api-key


# PhotoRoom (background removal, called direct by the app).
PHOTOROOM_API_KEY=TODO-set-photoroom-api-key

# App logging level.
LOG_LEVEL=DEBUG


# --- Read-only Output API (src/api) ---
# Root holding <app_id>/<run_id>/output.yaml + images. Defaults to this
# repo's apps/ dir; only set to serve runs from elsewhere.
# APPS_ROOT=/abs/path/to/apps
# Allowed CORS origins (JSON list). Default ["*"] — open, no auth.
# CORS_ORIGINS=["*"]
