flowchart TB
  %% ---------- CLIENTS ----------
  MobileApp["📱 <b>MobileApp</b> — Flutter member app (live client)<br/>Supabase auth · AuthGate → MemberGate → AppShell<br/>ApiClient (dio + JWT interceptor · 401 refresh · 403≠sign-out) → member portal<br/>SelectedMember identity (family picker) · theme hydration (theme_design_id)<br/>home / booking · rewards · profile (rank + progress graph) · videos feed/rec<br/>qr check-in (scanner · kiosk Phase G seam) · celebration (watermark)"]
  CRM["🖥️ <b>CRM</b> — gym admin web (full CRM)<br/>login · Supabase auth<br/>api_client (dio + auth interceptor) · BLoC repositories → FastApiBackend<br/>members list · member detail (billing) · gym setup (Stripe Connect)<br/>members video tab (FastApiBackend videos domain)<br/>live theme preview + showcase (ThemeService — read-only)<br/>theme-browser target · schedule board · shared widgets / deploy"]
  LandingPage["🌐 <b>LandingPage</b> — React-via-CDN site<br/>hero carousel · feed demo · loyalty loop<br/>pricing table · hifi/ copy + ds · S3 deploy"]

  %% ---------- THEME SERVICE: creation vs api (separate) ----------
  subgraph TS_create["🎨 ThemeService · CREATION (generator)"]
    direction TB
    TSc_brief["brand-brief skill →<br/>customization.yaml"]
    TSc_orch["CLI / orchestrator<br/>(async DAG)"]
    TSc_mods["modules<br/>color · font · image<br/>icon · text · lottie"]
    TSc_writer["writer → output.yaml"]
    TSc_up["asset uploader"]
    TSc_edit["edit_theme skill"]
    TS_scripts["scripts<br/>regen · regen_image · edit_customization · expand<br/>remove_bg · sync_assets · fetch_icon_sets"]
    TSc_brief --> TSc_orch --> TSc_mods --> TSc_writer --> TSc_up
    TSc_edit -. "operates" .-> TSc_orch
    TS_scripts -. "operate" .-> TSc_orch
  end
  subgraph TS_api["🎨 ThemeService · READ API"]
    direction TB
    TSa_api["read API<br/>/apps/{id}/styles"]
    TSa_pkg["ThemeFlutter pkg<br/>(client SDK)"]
    TSa_pkg -. "reads" .-> TSa_api
  end

  %% ---------- VIDEO SERVICE: creation vs api (separate) ----------
  subgraph VS_create["🎬 VideoService · CREATION (worker + authoring)"]
    direction TB
    VSc_skill["videoservice skill<br/>gym authoring"]
    VSc_gym["gym_maker → gym YAML"]
    VSc_sync["sync_gyms · import_yaml → template_gym* + pool + video_rag sidecar<br/>(vector(3072) · halfvec HNSW index)"]
    VSc_worker["worker (src/worker) · self-scheduling loop<br/>tick = lock → cleanup (drop strike-maxed videos) → finalize (complete/fail running runs)<br/>→ ONE drained step, first-with-work: scan (multimodal verdict) → enrich (gym-agnostic RAG sweep) → scrape (YouTube Data API v3, the only quota-bound/run-opening step, still derives its due gym from timestamps)<br/>writes video pool · video_rag · gym_video_feed runs · cost_log"]
    VSc_skill -. "drives" .-> VSc_gym
    VSc_gym --> VSc_sync
    VSc_sync -. "seeds pool + video_rag" .-> VSc_worker
  end

  %% ---------- BACKEND + DATABASE ----------
  subgraph FastApiBackend["⚙️ FastApiBackend — CRM / billing + video content API (not deployed)"]
    direction TB
    FB_r["routers<br/>members · gyms (incl. gym profile + gym theme-design PUT) · classes · checkin<br/>ranks · rewards (approval flow + points) · waivers · memberships · plans<br/>discounts · payments · webhooks · tasks<br/>employees (4-role staff roster · soft-archive · derived invite_status)<br/>videos (ONE unified feed [owner+latest-run merge · enriched+accepted gate · σ-boost + decayed-watch ranking] + ungated /videos/owner listing + spec/agent authoring + single rotating RAG rec)<br/>presets (template catalog + import, Settings-only)<br/>theme (gym showcase + public showcase-defaults) · uploads (S3 image proxy)<br/>member_portal (the MEMBER-facing surface · /api/v1/member · 13 routes · verify_member_self gated · the MobileApp's backend surface:<br/>own profile/rank/points/streak/history · gym schedule board · own reservations · active rewards + pending redeem · personalized video feed/rec/click)"]
    FB_s["services<br/>payments/Stripe · memberships · management · discounts · employees<br/>CheckinClassResolver · CheckinMemberGate · CheckinReverser<br/>LiteLLMClient (shared) · VideosService (facade) · VideoFeedService (unified feed + owner listing)<br/>VideoSpecService · VideoQueryGenerator (2-call) · VideoSpecAuthoring · VideoFeedRefiner · VideoFeedRefineRunner (coalesced feed_update auto-refine)<br/>VideoRecsService (single rotating-category pure-cosine rec, thin feed wrapper) · MemberVideoProfileService<br/>VideoRecClickService · MemberVideoProfileRefreshRunner (no semantic search)<br/>VideoAgentService (thin Pydantic AI agent wrapper)<br/>PresetsService · PresetsTemplateService<br/>ThemeShowcaseService · ThemeShowcaseDefaultsService · UploadsService<br/>MemberPortalService (the two member-facing reads no staff service answers: verified email → member rows across gyms · profile projection; every other route delegates to the CRM's own services)"]
    FB_q["per-domain SQL"]
    FB_core["core · config · DI · auth (4 roles matched by verified JWT email) · pydantic schemas"]
    FB_r --> FB_s --> FB_q
  end
  Database["🗄️ <b>Database</b> — Supabase Postgres<br/>supabase/schemas *.sql · access_rules (RLS)<br/>python_data enums · openapi.json contract · pgvector<br/>tables: member · gym · rank/reward · membership/billing · class<br/>video_* (failure_count strikes) · gym_video_* · template_gym* · video_rag (halfvec HNSW) · member_video_recs · members.video_profile_*"]
  Deploy["📦 <b>deploy/</b> — combined image<br/>FastApiBackend API + VideoService worker<br/>always-on (ECS Express), NOT App Runner"]

  %% ---------- EXTERNAL ----------
  Stripe["Stripe"]
  LiteLLM["OpenAI / LiteLLM"]
  Gemini["Gemini"]
  Apify["Apify<br/>supreme_coder/youtube-transcript-scraper (transcripts only · batched)"]
  YouTube["📺 YouTube Data API v3<br/>search.list discovery + videos.list metadata"]
  GoogleFonts["Google Fonts"]
  Recraft["Recraft"]
  CDN["S3 + CloudFront CDN<br/>cdn.combatden.net"]
  LLMProvider["🤖 Anthropic / LLM<br/>agent: Pydantic AI (AnthropicModel)<br/>regular calls: litellm (LiteLLMClient)<br/>default claude-sonnet-4-6"]

  %% ---------- CROSS-SYSTEM (root siblings only) ----------
  MobileApp -->|"authd /api/v1/member portal (profile · board · reservations · rewards · videos · showcase theme_design_id)"| FastApiBackend
  MobileApp -->|"Supabase Auth (login)"| Database
  MobileApp -->|"branding: GET /apps/{id}/styles (theme_flutter)"| TS_api
  CRM -->|"GET /apps/{id}/styles (theme catalog) + live preview"| TS_api
  CRM -->|"authd API (billing + video content) · public showcase-defaults + gym theme PUT"| FastApiBackend
  CRM -->|"Supabase Auth (login)"| Database
  LandingPage -->|"links to themes.combatden.net"| CRM
  LandingPage -.->|"build-time screenshots"| MobileApp
  LandingPage -.->|"build-time feed thumbnails (baked)"| VS_create
  TS_create -.->|"output.yaml"| TS_api
  VS_create -.->|"design_id + celebration img"| TS_create
  TS_create --> GoogleFonts
  TS_create --> Recraft
  TS_create --> LiteLLM
  TS_create -->|"uploads images / icons"| CDN
  VS_create -->|"scrape: discovery + metadata"| YouTube
  VS_create -->|"enrich: lazy transcripts"| Apify
  VS_create -->|"enrich: summary embeddings"| LiteLLM
  VS_create -->|"enrich + scan"| Gemini
  VS_create -->|"derive due gym from timestamps · write video / video_rag / gym_video_feed"| Database
  FastApiBackend -->|"read/write · Supabase Auth"| Database
  FastApiBackend -->|"webhooks + payments"| Stripe
  FastApiBackend -->|"videos: agent (Pydantic AI) + regular LLM calls (litellm)"| LLMProvider
  FastApiBackend -->|"videos: owner-add metadata"| YouTube
  FastApiBackend -.->|"packaged into"| Deploy
  VS_create -.->|"worker → combined image"| Deploy
  FastApiBackend -->|"image uploads (uploads domain)"| CDN

  classDef client fill:#e3f0ff,stroke:#2f6fb0,color:#0b2942;
  classDef ext fill:#ffd9a8,stroke:#d2691e,color:#4a2c08;
  class MobileApp,CRM,LandingPage client;
  class Stripe,LiteLLM,Gemini,Apify,YouTube,GoogleFonts,Recraft,CDN,LLMProvider ext;
  style TS_create fill:#dff0e6,stroke:#2f8f53;
  style TS_api fill:#eafff2,stroke:#2f8f53;
  style VS_create fill:#dff0e6,stroke:#2f8f53;
  style TS_scripts fill:#fdf6d8,stroke:#caab2f;
  style FastApiBackend fill:#e6f7ec,stroke:#2f8f53,stroke-dasharray:4 3;
  style Database fill:#fff2e0,stroke:#c9781f;
  style Deploy fill:#fdf6d8,stroke:#caab2f,stroke-dasharray:4 3;
  style MobileApp fill:#eaf2ff,stroke:#2f6fb0;
  style CRM fill:#eaf2ff,stroke:#2f6fb0;
  style LandingPage fill:#eaf2ff,stroke:#2f6fb0;
