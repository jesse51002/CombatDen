# In-project Poetry virtualenv
.venv/

# Python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/

# Local + prod secrets (never commit). Keep .env.example tracked.
.env
.env.*
!.env.example

# Generated preview HTML (scripts/preview.py) — sits next to each app's YAMLs
apps/*/preview.html

videos/

# Template-enrich RAG sidecar (~165 MB of pre-paid summaries + embeddings).
# Untracked-local like videos/ — too heavy + high-entropy to git-track;
# distributed to prod via S3 (see CLAUDE.md). Produced by `make enrich-templates`.
video_rag/
