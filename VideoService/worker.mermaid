flowchart TB
  %% ============================================================
  %% VideoService background worker — decoupled DB-backed steps
  %% Prose source of truth: VideoService/CLAUDE.md "The background worker".
  %% Rules: top-down TB, sibling-only edges (validate with check_siblings.py).
  %% ============================================================

  Legend["🧭 Legend — green = worker logic · orange = shared DB / external services · yellow = one-time tooling<br/>solid arrow = live call · dashed = lazy / optional / one-time / side-effect<br/>top-down = tick order · every edge connects siblings"]

  WorkerLoop["🔁 run.py loop (make worker)<br/>one tick per iteration · wait worker_poll_seconds (60)<br/>NOT a web server · no port · no queue"]

  subgraph Tick["🎬 The tick — WorkerService.run_tick (always, under one lock hold)"]
    direction TB
    t_lock["1 · acquire global TTL lock<br/>video_worker_run on resource_locks (non-blocking single-shot)<br/>TTL 900s · heartbeat 300s renews · a lost beat aborts the drain mid-step<br/>→ one worker instance active at a time"]
    t_cleanup["2 · cleanup (always, cheap)<br/>DELETE video WHERE failure_count >= worker_failure_max (3)<br/>FK cascades drop its feed rows · video_rag row · member recs<br/>runs FIRST so finalize's denominators reflect the shrunk feed"]
    t_finalize["3 · finalize (always, cheap)<br/>complete: a running run's terminal (accepted/rejected) fraction ≥ 0.9 of ALL its feed rows<br/>fail: zero feed rows past a 1h grace → 'no feed rows' · else stuck past a 24h TTL → 'run ttl exceeded'<br/>NO orphan rule — running is a legitimate long-lived multi-tick state"]
    t_lock --> t_cleanup
    t_cleanup --> t_finalize
  end

  subgraph Steps["⚙️ One heavy step, first-with-work, drained fully this tick"]
    direction TB
    s_scan["1st · SCAN — global sweep, per-gym batches, TEXT-ONLY<br/>targets: enriched rows (video under strike ceiling) in each gym's latest non-failed run, EITHER arm — (A) a 'pending' row's first verdict, OR (B) the feed_update RE-SCAN: an automatic row re-judged in place once a 'feed_update' spec version has settled ≥ 1h<br/>loads that gym's LATEST spec AT SCAN TIME · batches of 12 · judges the summary + genre/disciplines/facets (no thumbnail — enrich folded it into the summary)<br/>verdict UPDATE guarded on curation_type ≠ 'manual' (an owner's explicit keep/reject is never overwritten) · stamps scanned_at so the same feed_update never re-fires the row<br/>strike: a batch's LLM failure bumps every video in it and leaves them pending (no default-to-rejected)"]
    s_enrich["2nd, if scan had no work · ENRICH — global, gym-agnostic sweep<br/>targets: videos with NO video_rag row yet, under the strike ceiling<br/>(pending/accepted rows of each gym's latest non-failed run) ∪ ALL owner-section rows<br/>lazy Apify transcript fetch (a miss → placeholder, not a strike) → cache onto video<br/>ONE multimodal call → tag + disciplines + summary + facets · batch-embed summaries → insert video_rag<br/>strike: a hard multimodal/embed failure"]
    s_scrape["3rd, if scan+enrich had no work · SCRAPE — per-gym, quota-bound<br/>the ONLY step that opens video_run · bounded by per-gym (2/24h) + system (5/24h) rolling run caps<br/>selects the due gym (no in-flight run) → YouTube Data API v3 search+details → merge-upsert the pool<br/>funnel (tier1 query+discipline overlap, tier2 RAG probe) → write_feed:<br/>carries the prior completed run forward FIRST, then inserts candidates as 'pending' (ON CONFLICT DO NOTHING)"]
    s_scan -->|"no scan targets (pending or feed_update re-scan)"| s_enrich
    s_enrich -->|"no un-enriched targets"| s_scrape
  end

  EnrichTemplates["🛠️ make enrich-templates (one-time, PAID script)<br/>reuses WorkerEnricher.enrich_one — the same multimodal+embed unit<br/>enriches the ~18.9k unique template pool videos ONCE<br/>writes the untracked-local video_rag/ sidecar (base64-packed float32 embeddings)"]

  Cost["🧾 Cost ledger — cost_log, attributed per step<br/>every row: source='video' · stage · model · cost_usd · breakdown<br/>scrape — search FREE (quota diagnostic) + embed (tier-2 probe), keyed that gym + run<br/>enrich — transcript + enrich + embed, POOL-LEVEL (gym_id/run_id NULL — a swept video is shared across gyms)<br/>scan — one scan row per gym per sweep, keyed that gym + its latest run"]

  DB["🗄️ Shared Supabase Postgres<br/>resource_locks · video_run · gym_video_spec(_latest)<br/>video pool (failure_count strikes) · video_rag (pgvector vector(3072) · halfvec HNSW halfvec_cosine_ops) · gym_video_feed · cost_log"]
  YouTube["📺 YouTube Data API v3<br/>search.list discovery + videos.list metadata (free within ~10k units/day)"]
  Apify["🎞️ Apify · supreme_coder/youtube-transcript-scraper<br/>transcripts ONLY · lazy BATCHED fetch at enrich (~$0.0005/transcript + $0.001/actor start)"]
  LLM["🤖 Gemini — enrich (multimodal) · scan (text-only) · embed<br/>embed = gemini-embedding-001 → video_rag.embedding vector(3072)"]

  WorkerLoop --> Tick
  Tick -->|"one heavy step, first-with-work, drained fully"| Steps
  Steps -.->|"each step → cost_log rows"| Cost
  Tick -->|"lock · cleanup · finalize (read/write video + video_run)"| DB
  Steps -->|"read targets · upsert pool · write video_rag · write feed rows/runs"| DB
  Steps -->|"scrape: discovery + metadata"| YouTube
  Steps -.->|"enrich: lazy batched transcript"| Apify
  Steps -->|"enrich: classify + embed · scan: judge"| LLM
  Cost -->|"insert cost_log rows"| DB
  EnrichTemplates -.->|"reuses the enrich step's per-video unit"| Steps
  EnrichTemplates -.->|"reads the pool · writes the sidecar (import_yaml then seeds video_rag)"| DB

  classDef ext fill:#ffd9a8,stroke:#d2691e,color:#4a2c08;
  classDef data fill:#fff2e0,stroke:#c9781f,color:#4a2c08;
  classDef svc fill:#e6f7ec,stroke:#2f8f53,color:#0c3a1f;
  classDef tool fill:#fdf6d8,stroke:#caab2f,color:#4a3d08;
  class WorkerLoop svc;
  class YouTube,Apify,LLM ext;
  class DB,Cost data;
  class Legend,EnrichTemplates tool;
  style Tick fill:#dff0e6,stroke:#2f8f53;
  style Steps fill:#dff0e6,stroke:#2f8f53;
