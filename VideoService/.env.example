# VideoService environment.
#
# Copy to `.env` for local. For prod, keep a separate `.env.prod` (same keys,
# prod DATABASE_URL) — both .env and .env.prod are gitignored. The write scripts
# (sync-gyms / import-yaml) pick the file via the ENV_FILE flag, default `.env`:
#   ENV_FILE=.env.prod make sync-gyms GYM_ID=all
#   ENV_FILE=.env.prod make import-yaml
# The read API always uses `.env`.

# --- Required by the read API AND the pipeline scripts ---------------------
# The shared Supabase Postgres (direct async connection). The read API queries
# it; sync-gyms / import / scrape / scan write to it.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/combatden
# Optional pool tuning (sensible defaults).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_ECHO=false

# No auth: the demo hits the API directly. ["*"] keeps it open.
# CORS_ORIGINS=["*"]
# CDN base for the gym card's celebration image (served by ThemeService).
# DEFAULTS to the prod CDN (https://cdn.combatden.net), so the read API emits an
# absolute CDN URL without this being set. Set it empty to emit the
# ThemeService-relative path the client absolutises (local dev).
# ASSETS_CDN_BASE_URL=

# --- Required by the pipeline scripts only (not the read API) --------------
# Classification + scan pass (scripts/scraper, scripts/scan). Routes Gemma via
# the Gemini API; get a key from Google AI Studio.
# GEMINI_API_KEY=

# Apify scraper (scripts/scraper). Pay-per-result token from apify.com.
# APIFY_TOKEN=
