# Read-only Videos Config API.
# Both default sensibly; uncomment to override.

# Root that holds <app_id>/videos_config.yaml
# APPS_ROOT=/abs/path/to/apps

# No auth: the demo hits this directly. ["*"] keeps it open.
# CORS_ORIGINS=["*"]

# Required by the YouTube batch script (scripts/youtube_batch). Not used by the
# read-only API. Get one from a Google Cloud project with the YouTube Data API
# v3 enabled.
# YOUTUBE_API_KEY=

# Required by the classification pass (scripts/classify). Not used by the
# read-only API or the YouTube batch. Routes Gemma via the Gemini API; get a key
# from Google AI Studio.
# GEMINI_API_KEY=
