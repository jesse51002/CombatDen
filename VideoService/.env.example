# VideoService environment.
#
# Copy to `.env` for local. For prod, keep a separate `.env.prod` (same keys,
# prod DATABASE_URL) — both .env and .env.prod are gitignored. The write scripts
# (sync-gyms / the import step) pick the file via the ENV_FILE flag, default `.env`:
#   ENV_FILE=.env.prod make sync-gyms GYM_ID=all
#   ENV_FILE=.env.prod poetry run python -m scripts.import_yaml.run

# --- Required by the background worker AND the pipeline scripts ------------
# The shared Supabase Postgres (direct async connection). The worker reads +
# writes it; sync-gyms / import scripts write to it.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/combatden
# Optional pool tuning (sensible defaults).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_ECHO=false

# --- Required by the background worker (src/worker) ------------------------
# The worker self-schedules (no queue): each tick derives the highest-priority
# due gym and runs its scrape -> funnel -> enrich -> scan -> feed-write pipeline
# (`make worker`). It reads DATABASE_URL above (via src/shared/config.py), plus
# the keys below.
# YouTube Data API v3 key (Google Cloud) — discovery + metadata for the scrape.
# Free within the daily quota (10k units/day; search.list = 100 units → ~3 full
# gym runs/day by default; a quota increase is a free Google Cloud request).
YOUTUBE_API_KEY=
# Apify token — the lazy transcript fetch at enrich (one actor run per video). Get
# one at apify.com.
APIFY_TOKEN=
# Model provider keys the worker's litellm calls resolve (via src/core/config.py):
#   GEMINI_API_KEY — enrich + scan (default gemini/gemini-2.5-flash-lite)
#   OPENAI_API_KEY — summary + query embeddings (default openai/text-embedding-3-small)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional worker tuning — defaults live in src/worker/worker_config.py; set only to override.
# WORKER_ENABLED=true
# WORKER_POLL_SECONDS=60
# WORKER_LOCK_TTL_SECONDS=900
# WORKER_HEARTBEAT_SECONDS=300
# WORKER_SCRAPE_CONCURRENCY=4
# WORKER_ENRICH_CONCURRENCY=8
# WORKER_SCAN_CONCURRENCY=8
# WORKER_MAX_RESULTS_PER_QUERY=20
# SCAN_BUDGET_PER_RUN=1000
# SCAN_BATCH_SIZE=12
# RAG_PROBE_TOP_K=40
# ENRICH_TRANSCRIPT_CHAR_BUDGET=8000
# APIFY_TRANSCRIPT_COST_PER_VIDEO_USD=0.01
# ENRICH_MODEL=gemini/gemini-2.5-flash-lite
# SCAN_MODEL=gemini/gemini-2.5-flash-lite
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIM=1536
