# VideoService environment.
#
# Copy to `.env` for local. For prod, keep a separate `.env.prod` (same keys,
# prod DATABASE_URL) — both .env and .env.prod are gitignored. The write scripts
# (sync-gyms / import-yaml) pick the file via the ENV_FILE flag, default `.env`:
#   ENV_FILE=.env.prod make sync-gyms GYM_ID=all
#   ENV_FILE=.env.prod make import-yaml
# The read API always uses `.env`.

# --- Required by the read API AND the pipeline scripts ---------------------
# The shared Supabase Postgres (direct async connection). The read API queries
# it; sync-gyms / import / scrape / scan write to it.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/combatden
# Optional pool tuning (sensible defaults).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_ECHO=false

# No auth: the demo hits the API directly. ["*"] keeps it open.
# CORS_ORIGINS=["*"]
# CDN base for the gym card's celebration image (served by ThemeService).
# DEFAULTS to the prod CDN (https://cdn.combatden.net), so the read API emits an
# absolute CDN URL without this being set. Set it empty to emit the
# ThemeService-relative path the client absolutises (local dev).
# ASSETS_CDN_BASE_URL=

# --- Required by the background worker (src/worker) ------------------------
# The worker pops the video_worker_queue and runs a gym's
# scrape -> funnel -> enrich -> scan -> feed-write pipeline (`make worker`). It
# reads DATABASE_URL above (via src/api/config.py), plus the keys below.
# Apify pay-per-result token (the scrape stage). Get one at apify.com.
APIFY_TOKEN=
# Model provider keys the worker's litellm calls resolve (via src/core/config.py):
#   GEMINI_API_KEY — enrich + scan (default gemini/gemini-2.5-flash-lite)
#   OPENAI_API_KEY — summary + query embeddings (default openai/text-embedding-3-small)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional worker tuning — defaults live in src/worker/worker_config.py; set only to override.
# WORKER_ENABLED=true
# WORKER_POLL_SECONDS=60
# WORKER_LOCK_TTL_SECONDS=900
# WORKER_HEARTBEAT_SECONDS=300
# WORKER_SCRAPE_CONCURRENCY=4
# WORKER_ENRICH_CONCURRENCY=8
# WORKER_SCAN_CONCURRENCY=8
# WORKER_MAX_RESULTS_PER_QUERY=20
# SCAN_BUDGET_PER_RUN=1000
# SCAN_BATCH_SIZE=12
# RAG_PROBE_TOP_K=40
# ENRICH_TRANSCRIPT_CHAR_BUDGET=8000
# APIFY_COST_PER_VIDEO_USD=0.0024
# ENRICH_MODEL=gemini/gemini-2.5-flash-lite
# SCAN_MODEL=gemini/gemini-2.5-flash-lite
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIM=1536
