{
  "name": "theme-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The white-label theme runtime for the web, plus the standalone theme browser. The React mirror of ../ThemeFlutter.",
  "license": "UNLICENSED",
  "main": "./dist/theme-react.umd.js",
  "module": "./dist/theme-react.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/theme-react.js",
      "require": "./dist/theme-react.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && npm run build:lib && npm run build:types",
    "build:app": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:types": "tsc -b tsconfig.lib.json --force",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
