# Base-URL overrides. Both have working localhost defaults, so the dev loop
# needs no .env at all — copy this file only to point at something else.

# ThemeService's read API. Local: `cd ThemeService && make api`.
# Prod: https://theme.combatden.net
VITE_THEME_BASE_URL=http://localhost:8001

# FastApiBackend, for GET /api/v1/theme/showcase-defaults (public, no auth).
# Local: `cd FastApiBackend && make run`. Prod: https://api.combatden.net
VITE_BACKEND_BASE_URL=http://localhost:8000
