# Single env file. The app reads it (pydantic-settings). Copy to .env
# and fill the TODOs.

# Provider keys — the app calls each provider directly via litellm,
# routed by the provider prefix on each call's model id (model ids are
# per-call constants in the module that makes the call, not env vars).
# ANTHROPIC_API_KEY: image-prompt text. GEMINI_API_KEY: complexity
# classification + vision cutout validator. OPENAI_API_KEY: image
# generation (gpt-image).
ANTHROPIC_API_KEY=TODO-set-anthropic-api-key
GEMINI_API_KEY=TODO-set-gemini-api-key
OPENAI_API_KEY=TODO-set-openai-api-key


# Recraft (called direct by the app). Used for two things: the icon module
# generates a monochrome SVG for any icon slot a curated set can't honestly
# cover, and the image module strips the background off each generated image
# (removeBackground). One key for both. Register at https://www.recraft.ai/.
RECRAFT_API_KEY=TODO-set-recraft-api-key

# Curated icon-set catalog directory (one subdir per set, each with a
# set.yaml + icons/*.svg). Defaults to this repo's assets/icon_sets/;
# only set to serve icon sets from elsewhere.
# ICON_SETS_DIR=/abs/path/to/icon_sets

# Google Fonts Developer API key. The font module validates each picked
# family against the live Google Fonts catalog at pipeline-run time and
# the /apps/{app}/{run}/fonts/{slot} endpoint resolves woff2 URLs from
# the same catalog. Register at:
#   https://developers.google.com/fonts/docs/developer_api
GOOGLE_FONTS_API_KEY=TODO-set-google-fonts-api-key

# App logging level.
LOG_LEVEL=DEBUG


# --- Read-only Output API (src/api) ---
# Root holding <app_id>/<run_id>/output.yaml + images. Defaults to this
# repo's apps/ dir; only set to serve runs from elsewhere.
# APPS_ROOT=/abs/path/to/apps
# Allowed CORS origins (JSON list). Default ["*"] — open, no auth.
# CORS_ORIGINS=["*"]
# CDN base for image/icon assets. DEFAULTS to the prod CDN
# (https://cdn.combatden.net), so the API always emits absolute CDN URLs and
# the byte endpoints 307-redirect there — no env var needed in prod (the
# container no longer bakes image bytes, so a relative path would 404). To
# serve local files in the dev loop instead, set this empty:
# ASSETS_CDN_BASE_URL=
