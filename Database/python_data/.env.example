SUPABASE_URL=supabaseurl
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Anon key — used to sign gym owners in (password grant) and mint the JWT the
# seed sends to the backend's authenticated endpoints.
SUPABASE_ANON_KEY=your-anon-key-here

# FastAPI backend the seed POSTs to (defaults to http://127.0.0.1:8000).
BACKEND_URL=http://127.0.0.1:8000

# Stripe test-mode secret key (sk_test_...). Required for the overdue-member
# seed path, which creates customers/subscriptions under test clocks directly.
STRIPE_SECRET_KEY=stripe_secret
